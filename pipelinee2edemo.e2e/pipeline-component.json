{
  "schemaVersion": "2026-standalone-stage-v3",
  "pluginVersion": "1.0.0",
  "build": {
    "command": "npm ci && npm test",
    "packageCommand": "npm ci && npm run e2e:manifest"
  },
  "deployment": {
    "gates": {
      "e2e": {
        "kind": "project-e2e",
        "artifactPath": ".",
        "testManifestPath": "test-manifest.json",
        "suites": {
          "essential": {
            "command": "npm run e2e",
            "includeLabels": [
              "essential"
            ],
            "match": "any",
            "maxParallelShards": 1,
            "targetDurationSeconds": 60
          },
          "full": {
            "command": "npm run e2e",
            "allTests": true,
            "maxParallelShards": 1,
            "targetDurationSeconds": 120
          }
        },
        "report": {
          "format": "pipeline-e2e-v1",
          "path": "reports/e2e.json",
          "requireLabelsOnEveryTest": true
        },
        "inputs": {
          "deployment": {
            "component": "pipeline-e2e-demo-cdk",
            "outputs": [
              "appUrl"
            ]
          }
        }
      }
    }
  },
  "test": {
    "command": "npm test"
  },
  "browserTests": {
    "configFile": "playwright.fragment.mjs",
    "checks": {
      "browser": {
        "phase": "gate",
        "testDir": "tests/browser",
        "profiles": [
          "desktop-chromium",
          "mobile-webkit"
        ],
        "target": {
          "kind": "deployment",
          "input": "deployment.appUrl"
        }
      }
    }
  }
}
